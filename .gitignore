# Media files (user uploads) — keep the default avatar
media/*
!media/.gitkeep
!media/profile_pictures/
media/profile_pictures/*
!media/profile_pictures/default_avatar.jpg
#  如需将默认头像纳入版本管理，执行
#  git add media/profile_pictures/default_avatar.jpg

